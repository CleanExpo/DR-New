{
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm install --force --legacy-peer-deps",
  "buildCommand": "npx prisma generate && node scripts/force-build-pages.js && node scripts/generate-sitemap.js && next build",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=8192",
    "DATABASE_URL": "file:./prod.db",
    "SKIP_ENV_VALIDATION": "true",
    "NEXT_TELEMETRY_DISABLED": "1",
    "NEXTAUTH_URL": "https://dr-new.vercel.app",
    "NEXTAUTH_SECRET": "/LGn3ayna3ZCC2djiCZCM3RBo9wNHHqE08HVGkgzVcc=",
    "NEXT_PUBLIC_SITE_URL": "https://dr-new.vercel.app",
    "NEXT_PUBLIC_APP_URL": "https://dr-new.vercel.app",
    "NEXT_PUBLIC_DEMO_MODE": "false",
    "SKIP_BUILD_ERRORS": "true"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=8192",
      "DATABASE_URL": "file:./build.db",
      "NEXT_TELEMETRY_DISABLED": "1",
      "SKIP_ENV_VALIDATION": "true",
      "CI": "false",
      "NEXTAUTH_URL": "https://dr-new.vercel.app",
      "NEXTAUTH_SECRET": "/LGn3ayna3ZCC2djiCZCM3RBo9wNHHqE08HVGkgzVcc=",
      "NEXT_PUBLIC_SITE_URL": "https://dr-new.vercel.app",
      "NEXT_PUBLIC_APP_URL": "https://dr-new.vercel.app",
      "NEXT_PUBLIC_DEMO_MODE": "false",
      "SKIP_BUILD_ERRORS": "true"
    }
  },
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/**/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/**/route.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "regions": ["syd1"],
  "github": {
    "silent": true,
    "autoJobCancelation": false
  },
  "rewrites": [
    {
      "source": "/pitch-deck/presentation",
      "destination": "/pitch/investor"
    },
    {
      "source": "/pitch-deck",
      "destination": "/pitch"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "public": true
}
