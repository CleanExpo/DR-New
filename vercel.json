{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter nrpg-web run build && rm -rf apps/web/.next/cache",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/health-check",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cleanup-old-runs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-email-queue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-background-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/job-alerts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/contractor-payout-sweep",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/webhooks/cron/health-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/search-dominance/cron/rank-tracking",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/search-dominance/cron/traffic-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/search-dominance/cron/competitor-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/search-dominance/cron/dominance-aggregation",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/search-dominance/cron/blue-ocean-scan",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/search-dominance/cron/algorithm-monitor",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/cert-expiry-sweep",
      "schedule": "30 5 * * *"
    }
  ],
  "regions": ["syd1"]
}
