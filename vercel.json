{
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm ci --legacy-peer-deps",
  "buildCommand": "npm run build",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=2048",
    "NEXT_TELEMETRY_DISABLED": "1",
    "NEXT_PUBLIC_APP_URL": "https://dr-new-ten.vercel.app",
    "SKIP_BUILD_ERRORS": "true"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=2048",
      "NEXT_TELEMETRY_DISABLED": "1",
      "NEXT_PUBLIC_APP_URL": "https://dr-new-ten.vercel.app",
      "SKIP_BUILD_ERRORS": "true"
    }
  },
  "functions": {
    "app/api/**/*": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/**/route.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "app/**/route.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "regions": ["syd1"],
  "github": {
    "silent": true,
    "autoJobCancelation": false
  },
  "rewrites": [
    {
      "source": "/pitch-deck/presentation",
      "destination": "/pitch/investor"
    },
    {
      "source": "/pitch-deck",
      "destination": "/pitch"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "public": true
}
