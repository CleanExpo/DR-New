# PRODUCTION ENVIRONMENT VARIABLES - NRPG Platform
# Copy these to Vercel Environment Variables Dashboard
# DO NOT commit this file with real values

# ============================================================
# CRITICAL - Required for Production
# ============================================================

# Database (Use Vercel Postgres, Supabase, or Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# NextAuth Configuration (CRITICAL - Use generated secrets)
NEXTAUTH_URL="https://disasterrecoverynrpg.com.au"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# JWT Secret (CRITICAL - Use generated secret)
JWT_SECRET="generate-with-openssl-rand-base64-32"

# Node Environment
NODE_ENV="production"

# ============================================================
# PAYMENTS - Stripe (Rana sets live keys/prices in Vercel)
# ============================================================
# GATING: STRIPE_SECRET_KEY gates the production health check —
# /api/health runs an authenticated stripe.balance.retrieve(). Until it is a
# valid live key, /api/health returns 503 and the "Deploy Production ->
# Production Smoke Tests" job fails. The publishable key, webhook secrets, and
# price IDs are required for the payment FLOWS but do NOT gate the health check.
# Price IDs must match /^price_[A-Za-z0-9]+$/ (real IDs, not placeholder text).

# Core keys — STRIPE_SECRET_KEY is the CI-gating one
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Webhook signing secrets (one per configured Stripe endpoint)
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PAYMENTS_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
STRIPE_TENANT_WEBHOOK_SECRET="whsec_..."
STRIPE_REALTIME_WEBHOOK_SECRET="whsec_..."

# Price IDs — base plans (surfaced by /api/health env-parity)
STRIPE_BASIC_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# Price IDs — tenant plans (surfaced by /api/health env-parity)
STRIPE_TENANT_BASIC_PRICE_ID="price_..."
STRIPE_TENANT_PRO_PRICE_ID="price_..."
STRIPE_TENANT_ENTERPRISE_PRICE_ID="price_..."

# Price IDs — realtime plans
STRIPE_REALTIME_BASIC_PRICE_ID="price_..."
STRIPE_REALTIME_PRO_PRICE_ID="price_..."
STRIPE_REALTIME_ENTERPRISE_PRICE_ID="price_..."

# ============================================================
# IMPORTANT - Recommended for Production
# ============================================================

# Google Gemini API (for asset generation)
GEMINI_API_KEY="your-gemini-api-key-here"

# Redis (Use Upstash Redis for Vercel)
REDIS_URL="redis://default:password@host:6379"

# ============================================================
# OPTIONAL - Can Add Later
# ============================================================

# Email Configuration (for contact forms, notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="nrpg.team@gmail.com"
SMTP_PASSWORD="[Generate Gmail App Password]"
SMTP_FROM="nrpg.team@gmail.com"

# Monitoring (optional)
SENTRY_DSN=""

# Analytics (Vercel Analytics already integrated via code)
# No env var needed - @vercel/analytics package handles it

# ============================================================
# NOTES
# ============================================================

# Database Options:
# - Vercel Postgres: Easiest (integrated in Vercel dashboard)
# - Supabase: Good for auth + database combo
# - Neon: Serverless Postgres with free tier
# - Railway: Includes Redis + Postgres

# Redis Options:
# - Upstash: Best for Vercel (serverless, pay-per-request)
# - Vercel KV: Built-in key-value store (based on Upstash)

# Generate secrets with:
#   openssl rand -base64 32    (for NEXTAUTH_SECRET, JWT_SECRET)
#   openssl rand -hex 32       (for ANALYTICS_API_KEY)
