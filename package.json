{
  "name": "dr-nrpg-monorepo",
  "version": "1.0.0",
  "description": "Disaster Recovery NRPG Platform - Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:web": "turbo run dev --filter=dr-nrpg-web",
    "dev:backend": "turbo run dev --filter=backend",
    "build:web": "turbo run build --filter=dr-nrpg-web",
    "build:backend": "turbo run build --filter=backend",
    "test:web": "turbo run test --filter=dr-nrpg-web",
    "test:backend": "turbo run test --filter=backend",
    "db:generate": "turbo run db:generate --filter=dr-nrpg-web",
    "db:push": "turbo run db:push --filter=dr-nrpg-web",
    "db:migrate": "turbo run db:migrate --filter=dr-nrpg-web",
    "db:studio": "turbo run db:studio --filter=dr-nrpg-web",
    "seed:demo-admin": "tsx scripts/seed-demo-admin.ts",
    "seed:demo-admin-full": "tsx scripts/seed-demo-admin-with-tenant.ts",
    "storybook": "turbo run storybook --filter=dr-nrpg-web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "training:generate-images": "tsx scripts/generate-training-images.ts",
    "training:integrate-images": "tsx scripts/integrate-training-images.ts"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.4",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
