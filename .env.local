# ============================================================================
# PHASE 5: SECURITY & MONITORING
# ============================================================================

# CSRF Protection (CRITICAL - Required for all forms)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=52647752c113d62bcbbb23bc407df764f4f9104e4454363e60e1ea51413fc434

# Security Monitoring & Alerts
# Email address where security alerts are sent
SECURITY_ALERT_EMAIL=security@disasterrecovery.com.au

# Failed login threshold and account lockout settings
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW=15
ACCOUNT_LOCKOUT_DURATION=30

# ============================================================================
# FILE UPLOAD SECURITY (Optional but recommended)
# ============================================================================

# Maximum file upload size (10 MB default)
MAX_FILE_UPLOAD_SIZE=10485760

# Allowed MIME types for file uploads (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# VirusTotal API key for file scanning (optional)
# Get from: https://www.virustotal.com (free tier: 500 requests/day)
VIRUS_SCAN_API_KEY=your_virustotal_api_key_here

# ============================================================================
# ANALYTICS & ERROR TRACKING (Optional)
# ============================================================================

# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry Error Tracking DSN
# Get from: https://sentry.io
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ORG=your-org-name
SENTRY_PROJECT=disaster-recovery-nrpg
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ============================================================================
# 2FA & SESSION SECURITY
# ============================================================================

# Maximum concurrent sessions per user
MAX_CONCURRENT_SESSIONS=3

# Enable session device tracking
SESSION_DEVICE_TRACKING=true
