#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run full test suite before pushing
echo "Running pre-push validation..."

# Full type check
npm run type-check || {
  echo "❌ Type check failed. Fix errors before pushing."
  exit 1
}

# Lint all files
npm run lint || {
  echo "❌ Linting failed. Fix errors before pushing."
  exit 1
}

# Run full unit test suite with coverage
echo "Running full unit test suite..."
npm run test:ci || {
  echo "❌ Unit tests failed. Fix tests before pushing."
  exit 1
}

# Run integration tests
echo "Running integration tests..."
npm test -- --testPathPattern=integration --passWithNoTests || {
  echo "❌ Integration tests failed. Fix tests before pushing."
  exit 1
}

# Check test coverage thresholds
echo "Checking test coverage..."
npm run test:coverage -- --coverageReporters=text-summary || {
  echo "❌ Coverage below threshold. Add more tests before pushing."
  exit 1
}

# Security audit
npm run security:audit || {
  echo "⚠️  Security audit detected vulnerabilities. Review before pushing."
}

echo "✅ Pre-push validation passed!"
