#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔒 Running pre-commit security checks..."

# 1. Secret detection with secretlint
echo "📝 Checking for secrets..."
npx secretlint $(git diff --cached --name-only --diff-filter=ACM) || {
  echo "❌ Secret detection failed! Secrets found in staged files."
  echo "Run 'npm run security:secrets' to scan all files."
  exit 1
}

# 2. ESLint security rules
echo "🔍 Running ESLint security checks..."
npx eslint $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$') || {
  echo "⚠️  ESLint found security issues. Fix them before committing."
  exit 1
}

# 3. Check for .env files
echo "🔐 Checking for .env files..."
if git diff --cached --name-only | grep -E '\.env($|\..*$)' | grep -v '\.env\.example$' | grep -v '\.env\.training\.example$'; then
  echo "❌ ERROR: Attempting to commit .env files!"
  echo "These files may contain secrets and should not be committed."
  echo "Remove them with: git reset HEAD <file>"
  exit 1
fi

# 4. Check for hardcoded credentials patterns
echo "🕵️  Checking for hardcoded credentials..."
if git diff --cached -U0 | grep -E '(api[_-]?key|password|secret|token)["\s]*[:=]["\s]*[^"]{8,}'; then
  echo "⚠️  WARNING: Potential hardcoded credentials detected!"
  echo "Review your changes carefully before committing."
  echo "If this is a false positive, you can skip with: git commit --no-verify"
  exit 1
fi

echo "✅ All security checks passed!"
