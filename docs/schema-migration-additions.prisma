// NEW ENUMS TO ADD AT END OF schema.prisma (after existing enums)
// ============================================================================

enum ContractorVerificationStatus {
  PENDING                // Initial state when contractor signs up
  INCOMPLETE            // Missing required fields
  SUBMITTED             // All fields complete, ready for review
  UNDER_REVIEW          // Admin is reviewing
  APPROVED              // Verified and live
  REJECTED              // Application denied
  RESUBMISSION_REQUIRED // Needs corrections
  SUSPENDED             // Suspended after approval
  EXPIRED               // License expired
}

enum ServiceCoverageLevel {
  STANDARD       // Normal service
  PRIORITY       // Fast response
  EMERGENCY_ONLY // Only urgent calls
  LIMITED        // Conditional availability
}

enum ContractorDocumentType {
  BUSINESS_LICENSE
  IICRC_CERTIFICATE
  PUBLIC_LIABILITY_INSURANCE
  WORKERS_COMPENSATION
  PROFESSIONAL_INDEMNITY
  ABN_REGISTRATION
  POLICE_CHECK
  TRADE_LICENSE
  COMPANY_LOGO
  INSURANCE_CLAIM_EXAMPLE
  OTHER
}

enum DocumentStatus {
  PENDING        // Uploaded, awaiting review
  UNDER_REVIEW   // Admin reviewing
  APPROVED       // Verified
  REJECTED       // Not accepted
  EXPIRED        // Past expiry date
  REQUIRES_RENEWAL // Expiring soon
}

enum VerificationAction {
  PROFILE_CREATED
  SUBMITTED
  REVIEW_STARTED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  APPROVED
  REJECTED
  SUSPENDED
  UNSUSPENDED
  RESUBMISSION_REQUEST
  LICENSE_EXPIRED
  LICENSE_RENEWED
  STATUS_CHANGED
}

// ============================================================================
// NEW MODELS TO ADD
// ============================================================================

model ContractorDocument {
  id                  String                     @id @default(cuid())
  contractorId        String
  contractor          Contractor                 @relation("ContractorDocuments", fields: [contractorId], references: [id], onDelete: Cascade)

  // Document Metadata
  documentType        ContractorDocumentType
  fileName            String
  fileUrl             String
  fileSize            Int                        // Bytes
  mimeType            String

  // Verification
  status              DocumentStatus             @default(PENDING)
  uploadedAt          DateTime                   @default(now())
  verifiedAt          DateTime?
  verifiedBy          String?                    // Admin user ID
  rejectionReason     String?
  expiryDate          DateTime?
  issuedDate          DateTime?

  // Document Details
  documentNumber      String?
  issuingAuthority    String?
  stateIssued         AustralianState?

  // Security & Audit
  viewCount           Int                        @default(0)
  lastViewedAt        DateTime?
  lastViewedBy        String?

  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([contractorId, documentType])
  @@index([status])
  @@index([expiryDate])
  @@index([documentType, status])
}

model ContractorVerificationHistory {
  id                  String                        @id @default(cuid())
  contractorId        String
  contractor          Contractor                    @relation("VerificationHistory", fields: [contractorId], references: [id], onDelete: Cascade)

  // Action Details
  action              VerificationAction
  previousStatus      ContractorVerificationStatus?
  newStatus           ContractorVerificationStatus
  reason              String?
  notes               String?

  // Actor
  performedBy         String                        // User ID
  performedByName     String?
  isSystemAction      Boolean                       @default(false)

  // Metadata
  ipAddress           String?
  userAgent           String?
  metadata            Json?

  createdAt           DateTime                      @default(now())

  @@index([contractorId, createdAt])
  @@index([action])
  @@index([createdAt])
}

