          <tr><td><strong>Annual Service Cost:</strong></td><td>-$${serviceCost.toFixed(2)}</td></tr>\r\n                        <tr><td><strong>Annual Depreciation:</strong></td><td>-$${(totalCost/lifespan).toFixed(2)}</td></tr>\r\n                        <tr style=\"background: #f8f9fa;\">\r\n                            <td><strong>Annual Net Profit:</strong></td>\r\n                            <td><strong>$${annualProfit.toFixed(2)}</strong></td>\r\n                        </tr>\r\n                        <tr style=\"border-top: 2px solid #f39c12; font-size: 1.1em;\">\r\n                            <td><strong>${lifespan}-Year Total Profit:</strong></td>\r\n                            <td style=\"color: ${totalProfit > 0 ? 'green' : 'red'};\"><strong>$${totalProfit.toFixed(2)}</strong></td>\r\n                        </tr>\r\n                    </table>\r\n                    <div style=\"margin-top: 20px; padding: 15px; background: #fff3cd; border-radius: 5px;\">\r\n                        <h4>Recommendation:</h4>\r\n                        <p>${roi > 100 ? '✓ Excellent investment - Strong ROI justifies purchase' : roi > 50 ? '✓ Good investment - Positive ROI with reasonable payback' : roi > 0 ? '⚠ Marginal investment - Consider rental or increased utilization' : '✗ Poor investment - Rental recommended'}</p>\r\n                        <p style=\"margin-top: 10px;\"><strong>Break-even:</strong> ${Math.ceil(totalCost / rentalRate)} rental days</p>\r\n                        <p><strong>Utilisation Rate:</strong> ${((usageDays/365)*100).toFixed(1)}% of available days</p>\r\n                    </div>\r\n                </div>\r\n            `;\r\n\r\n            document.getElementById('roiResult').innerHTML = resultHTML;\r\n        }\r\n\r\n        function checkAnswers() {\r\n            const answers = {\r\n                q1: 'b', // Every 3 months on construction sites\r\n                q2: 'c', // 7 years for LGR dehumidifier\r\n                q3: 'b', // B