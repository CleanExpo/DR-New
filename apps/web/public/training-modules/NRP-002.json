5: 'b'  // Wet sampling\r\n            };\r\n\r\n            const explanations = {\r\n                q1: \"AS 4964:2004 is the Australian Standard specifically for asbestos testing in bulk materials. This standard defines sampling procedures, analysis methods, and reporting requirements for identifying asbestos-containing materials.\",\r\n                q2: \"AS 4964:2004 requires minimum PPE of P2 mask, disposable overalls, and gloves for asbestos sampling to protect workers from fiber exposure. Higher levels of protection may be required for extensive sampling or known contamination.\",\r\n                q3: \"NATA accreditation is mandatory for asbestos testing, air quality assessment, and soil contamination testing under Australian regulations. Lead paint testing requires NATA accreditation for laboratory analysis but not field testing.\",\r\n                q4: \"$150-300 per sample is the typical cost range for asbestos testing in Australia, including laboratory analysis by PLM (Polarized Light Microscopy) and professional reporting. Costs vary by location and laboratory.\",\r\n                q5: \"Wet sampling is required under AS 4964:2004 to minimize fiber release during sample collection. This involves misting the material with water before sampling to suppress airborne fibers and protect workers and occupants.\"\r\n            };\r\n\r\n            let score = 0;\r\n            let totalQuestions = 5;\r\n            let detailedHTML = '';\r\n\r\n            for (let i = 1; i <= totalQuestions; i++) {\r\n                const userAnswer = document.querySelector(`input[name=\"q${i}\"]:checked`);\r\n                const questionDiv = document.querySelector(`input[name=\"q${i}\"]`).closest('.question');\r\n\r\n                if (userAnswer && userAnswer.value === answers[`q${i}`]) {\r\n                    score++;\r\n                    questionDiv.style.borderLeftColor = '#27ae60';\r\n                    detailedHTML += `<div style=\"margin-bottom: 20