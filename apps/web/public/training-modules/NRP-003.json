ake the assessment (80% required)';\r\n            document.getElementById('passStatus').style.color = passed ? '#27ae60' : '#e74c3c';\r\n\r\n            document.getElementById('scoreDisplay').style.display = 'block';\r\n            document.getElementById('detailedResults').style.display = 'block';\r\n            document.getElementById('answerExplanations').innerHTML = detailedHTML;\r\n\r\n            // Scroll to results\r\n            document.getElementById('scoreDisplay').scrollIntoView({ behavior: 'smooth' });\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
