ionDiv.style.borderLeftColor = '#e74c3c';\r\n                    detailedHTML += `<div style=\"margin-bottom: 20px; padding: 15px; background: #f8d7da; border-left: 4px solid #e74c3c; border-radius: 5px;\">\r\n                        <strong>Question ${i}: Incorrect ✗</strong><br>\r\n                        <strong>Correct Answer:</strong> ${answers[`q${i}`].toUpperCase()}<br>\r\n                        <strong>Explanation:</strong> ${explanations[`q${i}`]}\r\n                    </div>`;\r\n                }\r\n            }\r\n\r\n            const percentage = (score / totalQuestions) * 100;\r\n            const passed = percentage >= 80;\r\n\r\n            document.getElementById('scoreText').textContent = `You scored ${score} out of ${totalQuestions} (${percentage.toFixed(1)}%)`;\r\n            document.getElementById('passStatus').textContent = passed ? 'PASSED - You meet the professional competency requirements' : 'FAILED - Please review the material and retake the assessment (80% required)';\r\n            document.getElementById('passStatus').style.color = passed ? '#27ae60' : '#e74c3c';\r\n\r\n            document.getElementById('scoreDisplay').style.display = 'block';\r\n            document.getElementById('detailedResults').style.display = 'block';\r\n            document.getElementById('answerExplanations').innerHTML = detailedHTML;\r\n\r\n            // Scroll to results\r\n            document.getElementById('scoreDisplay').scrollIntoView({ behavior: 'smooth' });\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
