alMultipliers = {\r\n                'drywall': 1.0,\r\n                'wood': 1.3,\r\n                'concrete': 1.5,\r\n                'insulation': 0.8,\r\n                'mixed': 1.2\r\n            };\r\n\r\n            // Mould type risk multipliers\r\n            const mouldMultipliers = {\r\n                'common': 1.0,\r\n                'toxic': 1.5,\r\n                'allergenic': 1.2,\r\n                'unknown': 1.3\r\n            };\r\n\r\n            // Location cost adjustments\r\n            const locationMultipliers = {\r\n                'sydney': 1.2,\r\n                'brisbane': 1.1,\r\n                'regional': 1.0,\r\n                'remote': 1.4\r\n            };\r\n\r\n            // Calculate base remediation cost\r\n            let baseRemediationCost = area * baseRates[level];\r\n            baseRemediationCost *= materialMultipliers[material];\r\n            baseRemediationCost *= mouldMultipliers[mouldType];\r\n            baseRemediationCost *= locationMultipliers[location];\r\n\r\n            // HVAC cleaning costs\r\n            let hvacCost = 0;\r\n            if (hvac === 'minor') hvacCost = 800;\r\n            if (hvac === 'major') hvacCost = 2500;\r\n\r\n            // Equipment rental (based on project size)\r\n            const daysRequired = Math.ceil(area / 20) + 1; // Roughly 20m²/day\r\n            const hepaRental = 275 * daysRequired;\r\n            const namRental = level >= 2 ? 225 * daysRequired : 0;\r\n            const totalEquipmentRental = hepaRental + namRental;\r\n\r\n            // Consumables and supplies\r\n            const polySheetingCost = Math.ceil(area * 1.5) * 8; // 1.5x area for overlap\r\n            const antimicrobialCost = area * 12; // $12/m² for treatment\r\n            const ppeCost = daysRequired * 85; // PPE per day\r\n\r\n            // Testing costs\r\n            let testingCost = 0;\r\n            if (level >= 3) testingCost = 650; // Mandatory clearance\r\n            if (moul