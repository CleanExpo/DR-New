     <li><strong>Estimated Duration:</strong> ${hours} hours initial response</li>\r\n                            <li><strong>Coverage Area:</strong> ${propertySize}m² property</li>\r\n                            <li><strong>Time Factor:</strong> ${timeOfCall === 'business' ? 'Standard rates' : timeOfCall === 'afterhours' ? '1.5x after hours' : timeOfCall === 'weekend' ? '1.75x weekend' : '2x public holiday'} rates apply</li>\r\n                        </ul>\r\n                        <p style=\"margin-top: 15px;\"><strong>Insurance:</strong> Direct billing available for approved claims</p>\r\n                        <p><strong>Guarantee:</strong> 24/7 response commitment with real-time updates</p>\r\n                    </div>\r\n                </div>\r\n            `;\r\n\r\n            document.getElementById('responseResult').innerHTML = resultHTML;\r\n        }\r\n\r\n        function checkAnswers() {\r\n            const answers = {\r\n                q1: 'b', // 30 minutes for Priority 1\r\n                q2: 'c', // 132 500 for SES\r\n                q3: 'b', // Do not enter until safe\r\n                q4: 'd', // 7 years retention\r\n                q5: 'b'  // Within 2 hours for initial assessment\r\n            };\r\n\r\n            let score = 0;\r\n            let feedback = '<div class=\"result-box\"><h3>Assessment Results</h3>';\r\n\r\n            for (let i = 1; i <= 5; i++) {\r\n                const selected = document.querySelector(`input[name=\"q${i}\"]:checked`);\r\n                if (selected && selected.value === answers[`q${i}`]) {\r\n                    score++;\r\n                    feedback += `<p style=\"color: green;\">✓ Question ${i}: Correct</p>`;\r\n                } else {\r\n                    feedback += `<p style=\"color: red;\">✗ Question ${i}: Incorrect</p>`;\r\n                }\r\n            }\r\n\r\n            feedback += `<h4 style=\"margin-top: 20px;\">Score: ${score}/5 (${score*20}%)</h4>`;\r\n\r\n            if (