{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@anthropic-ai/claude-agent-sdk": ["./src/shims/claude-agent-sdk"],
      "isomorphic-dompurify": ["./src/shims/isomorphic-dompurify"],
      "rate-limiter-flexible": ["./src/shims/rate-limiter-flexible"],
      "@storybook/react": ["./src/shims/storybook-react"],
      "@langchain/google-vertexai": ["./src/shims/langchain-google-vertexai"],
      "@google-cloud/vertexai": ["./src/shims/google-cloud-vertexai"],
      "@/*": ["./*", "./src/*"],
      "@tests/*": ["./tests/*"],
      "@shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["jest", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/services/inspection/**/*",
    "src/lib/ai/**/*",
    "src/services/analytics/**/*"
  ],
  "references": [
    { "path": "../../packages/shared" }
  ]
}
