# =============================================
# Disaster Recovery NRPG Platform
# Environment Variables Template
# =============================================

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/disaster_recovery?schema=public"

# ===========================================
# AUTHENTICATION
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# ===========================================
# MULTI-TENANT CONFIGURATION
# ===========================================
# Base domain for tenant resolution (subdomain extraction)
BASE_DOMAIN="disasterrecovery.com.au"

# ===========================================
# AI PROVIDERS
# ===========================================

# Anthropic Claude (Primary LLM Provider)
ANTHROPIC_API_KEY="sk-ant-..."
AGENT_DEFAULT_MODEL="claude-sonnet-4-20250514"

# OpenAI (Secondary LLM Provider)
OPENAI_API_KEY="sk-..."
OPENAI_DEFAULT_MODEL="gpt-4o"

# Google Gemini
GEMINI_API_KEY="..."
GOOGLE_GENERATIVE_AI_API_KEY="..."

# Ollama (Local LLM)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# ===========================================
# AI CONFIGURATION
# ===========================================
AI_PROVIDER="anthropic"
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_MS=55000
AGENT_ENABLE_STREAMING=true
ENABLE_AI_ENHANCEMENT=true

# ===========================================
# T5GEMMA LOCAL MODEL
# ===========================================
T5GEMMA_MODEL_SIZE="2b"
T5GEMMA_DEVICE="cpu"
T5GEMMA_MAX_LENGTH=512
T5GEMMA_BATCH_SIZE=8
T5GEMMA_CACHE_DIR="./models"

# ===========================================
# QUEUE SYSTEM (Bull + Redis)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# STRIPE PAYMENTS
# ===========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PAYMENTS_WEBHOOK_SECRET="whsec_..."

# ===========================================
# SUPABASE (Real-time)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===========================================
# EMAIL (Resend)
# ===========================================
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@disasterrecovery.com.au"

# ===========================================
# GOOGLE SERVICES
# ===========================================
GOOGLE_MAPS_API_KEY="..."
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ===========================================
# FEATURE FLAGS
# ===========================================
FEATURE_AI_CLAIM_TRIAGE=true
FEATURE_AI_SEMANTIC_SEARCH=true
FEATURE_AI_FRAUD_DETECTION=false
FEATURE_AI_DYNAMIC_PRICING=false
FEATURE_AI_SUPER_ORCHESTRATOR=false

# ===========================================
# UPSTASH (Rate Limiting)
# ===========================================
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ===========================================
# VERCEL
# ===========================================
VERCEL_URL="..."
