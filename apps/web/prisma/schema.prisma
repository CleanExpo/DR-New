generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String                @id @default(cuid())
  name               String
  domain             String?               @unique
  subdomain          String?               @unique
  logo               String?
  primaryColor       String?
  secondaryColor     String?
  customCss          String?
  industry           String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  contractorProfiles ContractorProfile[]
  messages           Message[]
  serviceRequests    ServiceRequest[]
  configurations     TenantConfiguration[]
  users              User[]

  @@map("tenants")
}

model TenantConfiguration {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_configurations")
}

model User {
  id                           String                         @id @default(cuid())
  email                        String                         @unique
  name                         String?
  password                     String?
  userType                     UserType                       @default(CLIENT)
  googleId                     String?                        @unique
  avatar                       String?
  australianPhoneNumber        String?
  australianPostcode           String?
  australianState              AustralianState?
  suburb                       String?
  streetAddress                String?
  isEmailVerified              Boolean                        @default(false)
  emailVerificationToken       String?
  emailVerificationTokenExpiry DateTime?
  isActive                     Boolean                        @default(true)
  isBlocked                    Boolean                        @default(false)
  lastLoginAt                  DateTime?
  tenantId                     String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  bookings                     Booking[]                      @relation("ClientBookings")
  contractor                   Contractor?
  auClaims                     InsuranceClaimAU[]             @relation("ClientClaims")
  auInvoices                   InvoiceAU[]                    @relation("ClientInvoices")
  loginAttempts                LoginAttempt[]
  payments                     Payment[]
  ratings                      Rating[]
  verificationTokens           VerificationToken[]
  activitiesAsCustomer         Activity[]                     @relation("ActivityCustomer")
  activitiesPerformed          Activity[]                     @relation("ActivityPerformer")
  businessRules                BusinessRule[]                 @relation("BusinessRuleOwner")
  ClientProfile                ClientProfile?
  connectionLogs               ConnectionLog[]                @relation("UserConnectionLogs")
  contractorPreferences        ContractorPreferences?
  contractorProfile            ContractorProfile?
  lifecycle                    CustomerLifecycle?             @relation("CustomerLifecycle")
  createdReports               InspectionReport[]             @relation("CreatedReports")
  finalApprovals               InspectionReport[]             @relation("FinalApprovals")
  inspectionReports            InspectionReport[]             @relation("InspectorReports")
  managerReviews               InspectionReport[]             @relation("ManagerReviews")
  technicalReviews             InspectionReport[]             @relation("TechnicalReviews")
  receivedMessages             Message[]                      @relation("MessageReceiver")
  sentMessages                 Message[]                      @relation("MessageSender")
  reportRevisions              ReportRevision[]               @relation("ReportRevisions")
  ServiceRequestCalloutPayment ServiceRequestCalloutPayment[]
  serviceRequests              ServiceRequest[]
  tasksAssigned                Task[]                         @relation("TaskAssignee")
  tasksCreated                 Task[]                         @relation("TaskCreator")
  preferences                  UserPreferences?
  tenant                       Tenant?                        @relation(fields: [tenantId], references: [id])
  workspaceAuditLogs           WorkspaceAuditLog[]            @relation("WorkspaceAuditLogs")
  invitedMembers               WorkspaceMember[]              @relation("MemberInviter")
  workspaceMemberships         WorkspaceMember[]
  ownedWorkspaces              Workspace[]                    @relation("WorkspaceOwner")

  @@index([email])
  @@index([userType])
  @@index([australianState])
  @@index([isActive])
  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  interests            String[]
  serviceTypes         String[]
  budgetRange          String?
  urgencyLevel         String?
  communicationStyle   String?
  notificationSettings Json?
  dashboardLayout      Json?
  themePreferences     Json?
  isOnboardingComplete Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  brandingColor        String?
  selectedTheme        String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String
  ipAddress   String
  userAgent   String
  success     Boolean
  attemptedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ipAddress])
  @@index([attemptedAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  performedBy String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityId])
  @@index([entityType])
  @@index([performedBy])
}

model Contractor {
  id                            String                   @id @default(cuid())
  userId                        String                   @unique
  businessName                  String
  abnNumber                     String?                  @unique
  acnNumber                     String?                  @unique
  businessRegistrationDate      DateTime?
  primaryPostcode               String?
  primaryState                  AustralianState?
  operatingStates               AustralianState[]
  nrpgMemberId                  String?                  @unique
  nrpgVerifiedAt                DateTime?
  nrpgVerificationLevel         String?
  australianSpecialties         AustralianServiceType[]
  supportedEmergencyLevels      EmergencyResponseLevel[]
  publicLiabilityPolicyNumber   String?
  publicLiabilityExpiryDate     DateTime?
  publicLiabilityCertificateUrl String?
  workCoverNumber               String?
  workCoverExpiryDate           DateTime?
  completedJobs                 Int                      @default(0)
  averageRating                 Decimal                  @default(0.00)
  averageResponseTimeMinutes    Int                      @default(0)
  isVerified                    Boolean                  @default(false)
  verificationDate              DateTime?
  lastBackgroundCheckDate       DateTime?
  backgroundCheckStatus         String?
  isActive                      Boolean                  @default(true)
  isSuspended                   Boolean                  @default(false)
  suspensionReason              String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  bookings                      Booking[]                @relation("ContractorBookings")
  user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAreas                  ContractorServiceArea[]  @relation("ServiceAreas")
  iicrcCertifications           IICRCCertification[]     @relation("ContractorCertifications")
  auInvoices                    InvoiceAU[]              @relation("ContractorInvoices")
  payments                      Payment[]                @relation("ContractorPayments")
  ratings                       Rating[]
  activities                    Activity[]               @relation("ActivityContractor")
  betaEnrollments               BetaEnrollment[]         @relation("ContractorBetaEnrollments")
  betaFeedback                  BetaFeedback[]           @relation("ContractorBetaFeedback")
  betaNpsSurveys                BetaNPSSurvey[]          @relation("ContractorBetaNPSSurveys")
  notificationPreference        NotificationPreference?  @relation("ContractorNotificationPreference")
  opportunities                 Opportunity[]            @relation("OpportunityContractor")
  realtimeSubscription          RealtimeSubscription?    @relation("ContractorRealtimeSubscription")

  @@index([businessName])
  @@index([primaryState])
  @@index([nrpgMemberId])
  @@index([isVerified])
  @@index([isActive])
  @@index([abnNumber])
}

model IICRCCertification {
  id                  String                  @id @default(cuid())
  contractorId        String
  certificationLevel  IICRCCertificationLevel
  certificationCode   String                  @unique
  certificationDate   DateTime
  expiryDate          DateTime
  verificationDate    DateTime?
  isActive            Boolean                 @default(true)
  verifiedBy          String?
  certificatePdfUrl   String?
  certificateFileName String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  contractor          Contractor              @relation("ContractorCertifications", fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, certificationLevel, certificationCode])
  @@index([contractorId])
  @@index([certificationCode])
  @@index([expiryDate])
  @@index([isActive])
}

model ContractorServiceArea {
  id                  String          @id @default(cuid())
  contractorId        String
  postcode            String
  state               AustralianState
  isActive            Boolean         @default(true)
  responseTimeMinutes Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  contractor          Contractor      @relation("ServiceAreas", fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, postcode])
  @@index([postcode])
  @@index([state])
  @@index([contractorId])
}

model AdminServiceCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  icon        String?
  theme       String
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  services    AdminService[]

  @@map("admin_service_categories")
}

model AdminService {
  id          String               @id @default(cuid())
  categoryId  String
  name        String
  description String?
  icon        String?
  theme       String
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  category    AdminServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@map("admin_services")
}

model AdminTheme {
  id              String   @id @default(cuid())
  name            String
  identifier      String   @unique
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  textColor       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("admin_themes")
}

model ServiceRequest {
  id              String                        @id @default(cuid())
  userId          String
  serviceCategory String
  urgency         String
  serviceTitle    String
  description     String
  location        String
  budget          String?
  phone           String?
  preferredTime   String?
  insurance       Boolean                       @default(false)
  urgentResponse  Boolean                       @default(false)
  status          ServiceStatus                 @default(PENDING)
  leadScore       Float?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  tenantId        String?
  matches         ContractorMatch[]
  opportunity     Opportunity?                  @relation("OpportunityServiceRequest")
  calloutPayment  ServiceRequestCalloutPayment?
  tenant          Tenant?                       @relation(fields: [tenantId], references: [id])
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("service_requests")
}

model ServiceRequestCalloutPayment {
  id                            String               @id @default(cuid())
  serviceRequestId              String               @unique
  clientId                      String
  contractorProfileId           String?
  totalAUD                      Decimal
  totalExGstAUD                 Decimal
  gstAUD                        Decimal
  platformFeeAUD                Decimal
  platformFeeExGstAUD           Decimal
  platformFeeGstAUD             Decimal
  contractorEntitlementAUD      Decimal
  contractorEntitlementExGstAUD Decimal
  contractorEntitlementGstAUD   Decimal
  gstInclusive                  Boolean              @default(true)
  status                        CalloutPaymentStatus @default(CREATED)
  stripeCheckoutSessionId       String?              @unique
  stripePaymentIntentId         String?              @unique
  stripeTransferId              String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  client                        User                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractorProfile             ContractorProfile?   @relation(fields: [contractorProfileId], references: [id])
  serviceRequest                ServiceRequest       @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([contractorProfileId])
  @@index([status])
  @@map("service_request_callout_payments")
}

model ContractorProfile {
  id                           String                         @id @default(cuid())
  userId                       String                         @unique
  businessName                 String?
  phone                        String?
  address                      String?
  city                         String?
  state                        String?
  zipCode                      String?
  licenseNumber                String?
  insuranceProvider            String?
  insuranceExpiry              DateTime?
  services                     String[]
  serviceAreas                 String[]
  hourlyRate                   Float?
  experience                   Int                            @default(0)
  rating                       Float                          @default(0.0)
  totalJobs                    Int                            @default(0)
  bio                          String?
  availability                 AvailabilityStatus             @default(AVAILABLE)
  isVerified                   Boolean                        @default(false)
  stripeConnectAccountId       String?                        @unique
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  tenantId                     String?
  matches                      ContractorMatch[]
  tenant                       Tenant?                        @relation(fields: [tenantId], references: [id])
  user                         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ServiceRequestCalloutPayment ServiceRequestCalloutPayment[]

  @@map("contractor_profiles")
}

model ContractorMatch {
  id                String            @id @default(cuid())
  contractorId      String
  serviceRequestId  String
  matchScore        Float
  status            MatchStatus       @default(PENDING)
  contractorMessage String?
  clientMessage     String?
  budget            String?
  timeline          String?
  startDate         String?
  estimatedHours    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contractor        ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  serviceRequest    ServiceRequest    @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("contractor_matches")
}

model ContractorPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  serviceCategories    String[]
  locations            String[]
  experience           String?
  expertise            String[]
  background           String?
  hourlyRate           String?
  availability         String?
  maxDistance          String?
  selectedTheme        String?
  brandingColor        String?
  isOnboardingComplete Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contractor_preferences")
}

model ClientProfile {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  displayName             String?
  phoneNumber             String?
  phoneNumberVerified     Boolean                  @default(false)
  preferredContactMethod  String                   @default("email")
  timezone                String                   @default("Australia/Sydney")
  language                String                   @default("en-AU")
  propertyOwnershipStatus String?
  propertyCount           Int                      @default(1)
  isProfileComplete       Boolean                  @default(false)
  tier                    String                   @default("standard")
  vipAssignedManagerId    String?
  riskZone                String?
  riskAssessmentOffered   Boolean                  @default(false)
  riskAssessmentCompleted Boolean                  @default(false)
  flaggedForReview        Boolean                  @default(false)
  flagReason              String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  emergencyContacts       ClientEmergencyContact[]
  insurance               ClientInsurance?
  onboarding              ClientOnboarding?
  payment                 ClientPayment?
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties              ClientProperty[]

  @@index([tier])
  @@index([riskZone])
  @@index([flaggedForReview])
  @@map("client_profiles")
}

model ClientProperty {
  id                  String          @id @default(cuid())
  clientProfileId     String
  streetAddress       String
  suburb              String
  postcode            String
  state               AustralianState
  country             String          @default("AU")
  propertyType        String
  propertySize        String?
  buildingAge         String?
  accessInstructions  String?
  accessKeyId         String?
  accessDecryptedAt   DateTime?
  accessDecryptedBy   String?
  parkingAvailable    Boolean         @default(true)
  securityAccess      Boolean         @default(false)
  petOnPremises       Boolean         @default(false)
  petDetails          String?
  recommendedServices String[]
  isPrimary           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  clientProfile       ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
  @@index([postcode])
  @@index([state])
  @@map("client_properties")
}

model ClientInsurance {
  id                    String        @id @default(cuid())
  clientProfileId       String        @unique
  hasInsurance          Boolean       @default(false)
  insuranceProvider     String?
  policyNumber          String?
  policyExpiryDate      DateTime?
  policyDocumentUrls    String[]
  policyVerified        Boolean       @default(false)
  verifiedAt            DateTime?
  verifiedBy            String?
  hasPreviousClaims     Boolean       @default(false)
  claimCount            Int           @default(0)
  lastClaimDate         DateTime?
  preferredContractors  String[]
  restrictedContractors String[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  clientProfile         ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([policyExpiryDate])
  @@index([policyVerified])
  @@map("client_insurance")
}

model ClientPayment {
  id                    String           @id @default(cuid())
  clientProfileId       String           @unique
  stripeCustomerId      String?          @unique
  stripePaymentMethodId String?
  cardBrand             String?
  cardLast4             String?
  cardExpiryMonth       Int?
  cardExpiryYear        Int?
  billingAddressSameAs  Boolean          @default(true)
  billingStreet         String?
  billingSuburb         String?
  billingPostcode       String?
  billingState          AustralianState?
  autoPayEnabled        Boolean          @default(false)
  invoiceDeliveryMethod String           @default("email")
  taxInvoiceRecipient   String?
  abnNumber             String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  clientProfile         ClientProfile    @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([cardExpiryMonth, cardExpiryYear])
  @@map("client_payments")
}

model ClientEmergencyContact {
  id                     String        @id @default(cuid())
  clientProfileId        String
  name                   String
  relationship           String
  phone                  String
  email                  String?
  allowContractorContact Boolean       @default(false)
  isPrimary              Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  clientProfile          ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  @@index([clientProfileId])
  @@index([isPrimary])
  @@map("client_emergency_contacts")
}

model ClientOnboarding {
  id                    String                 @id @default(cuid())
  clientId              String                 @unique
  startDate             DateTime?
  targetCompletionDate  DateTime?
  actualCompletionDate  DateTime?
  status                OnboardingStatus       @default(PENDING_START)
  currentPhase          String?
  completedPhases       String[]
  flowVariant           String?
  experimentId          String?
  certificateIssued     Boolean                @default(false)
  certificateUrl        String?
  tourCompleted         Boolean                @default(false)
  firstRequestCreated   Boolean                @default(false)
  badgeAwarded          Boolean                @default(false)
  totalTimeSpentSeconds Int                    @default(0)
  deviceType            String?
  browserLanguage       String?
  lastActivityAt        DateTime?
  abandonedAt           DateTime?
  abandonedPhase        String?
  reminderSentAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  moduleProgress        ClientModuleProgress[]
  clientProfile         ClientProfile          @relation(fields: [clientId], references: [userId], onDelete: Cascade)

  @@index([status])
  @@index([currentPhase])
  @@index([flowVariant])
  @@index([lastActivityAt])
  @@map("client_onboarding")
}

model ClientModuleProgress {
  id               String           @id @default(cuid())
  onboardingId     String
  moduleId         String
  moduleName       String?
  startedAt        DateTime?
  completedAt      DateTime?
  completed        Boolean          @default(false)
  status           ModuleStatus     @default(NOT_STARTED)
  progress         Int              @default(0)
  quizScore        Int?
  quizAttempts     Int              @default(0)
  quizPassed       Boolean          @default(false)
  timeSpentSeconds Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  onboarding       ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([status])
  @@index([completed])
  @@map("client_module_progress")
}

model Workspace {
  id                   String               @id @default(cuid())
  businessName         String
  abnNumber            String?              @unique
  acnNumber            String?
  subscriptionTier     SubscriptionTier     @default(BASIC)
  subscriptionStatus   SubscriptionStatus   @default(TRIAL)
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  seatLimit            Int                  @default(1)
  monthlyJobLimit      Int                  @default(10)
  serviceRadiusKm      Int                  @default(25)
  currentMonthJobs     Int                  @default(0)
  totalJobsCompleted   Int                  @default(0)
  totalOverageFees     Decimal              @default(0)
  crmType              String?
  crmApiKey            String?
  crmWebhookSecret     String?
  completionRate       Decimal              @default(0)
  averageRating        Decimal              @default(0)
  averageResponseTime  Int                  @default(0)
  totalDeclines        Int                  @default(0)
  isActive             Boolean              @default(true)
  suspendedAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  ownerId              String
  rotationQueue        ContractorRotation[]
  auditLogs            WorkspaceAuditLog[]
  members              WorkspaceMember[]
  owner                User                 @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  @@index([subscriptionStatus])
  @@index([subscriptionTier])
  @@index([abnNumber])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(TECHNICIAN)
  invitedBy   String?
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  inviter     User?               @relation("MemberInviter", fields: [invitedBy], references: [id])
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model ContractorRotation {
  id                 String    @id @default(cuid())
  workspaceId        String
  postcode           String
  lastJobReceivedAt  DateTime?
  totalJobsReceived  Int       @default(0)
  totalJobsDeclined  Int       @default(0)
  declineRate        Decimal   @default(0)
  availabilityStatus String    @default("available")
  serviceRadiusKm    Int       @default(25)
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, postcode])
  @@index([postcode])
  @@index([lastJobReceivedAt])
  @@index([availabilityStatus])
  @@map("contractor_rotation")
}

model WorkspaceAuditLog {
  id          String     @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  user        User?      @relation("WorkspaceAuditLogs", fields: [userId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("workspace_audit_logs")
}

model Booking {
  id                         String                 @id @default(cuid())
  clientId                   String
  contractorId               String?
  australianServiceType      AustralianServiceType
  description                String
  estimatedDamagePhotosCount Int                    @default(0)
  servicePostcode            String
  serviceState               AustralianState
  serviceSuburb              String
  streetAddress              String
  status                     BookingStatus          @default(PENDING)
  emergencyResponseLevel     EmergencyResponseLevel @default(STANDARD)
  scheduledDate              DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  estimatedCostAUD           Decimal
  finalCostAUD               Decimal?
  notes                      String?
  internalNotes              String?
  clientNotes                String?
  damagePhotos               String[]
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  client                     User                   @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  contractor                 Contractor?            @relation("ContractorBookings", fields: [contractorId], references: [id])
  auClaims                   InsuranceClaimAU[]     @relation("BookingClaims")
  payments                   Payment[]              @relation("BookingPayments")
