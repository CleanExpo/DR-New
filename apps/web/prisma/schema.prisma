  // Additional Information
  additionalInfo           String?   @db.Text
  website                  String?
  availability24x7         Boolean   @default(false)
  emergencyResponseTime    String?

  // Consent
  termsAccepted            Boolean
  backgroundCheckConsent   Boolean

  // Application Scoring
  applicationScore         Int       @default(0)
  status                   String    @default("PENDING") // PENDING | UNDER_REVIEW | APPROVED | REJECTED | CONTACTED

  // Review Process
  reviewedBy               String?
  reviewedAt               DateTime?
  reviewNotes              String?   @db.Text
  approvalReason           String?   @db.Text
  rejectionReason          String?   @db.Text

  // Attribution
  source                   String?
  referrer                 String?
  submittedAt              DateTime  @default(now())
  ipAddress                String?
  userAgent                String?

  // Timestamps
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status])
  @@index([submittedAt])
  @@index([applicationScore])
  @@index([contactEmail])
  @@index([state])
  @@map("contractor_inquiries")
}

// ============================================
// Job Management Models
// ============================================

model Job {
  id               String        @id @default(cuid())
  jobNumber        String        @unique // NRP-2026-XXXXX format
  type             String        // water | fire | mould | storm | asbestos
  status           JobStatus     @default(PENDING)
  propertyId       String
  contractorId     String?
  clientId         String?
  estimatedCost    Decimal?
  actualCost       Decimal?
  scheduledDate    DateTime?
  completedDate    DateTime?
  notes            String?
  insuranceClaimId String?
  hoursWorked      Decimal?
  materialsUsed    String?
  tenantId         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  property         ClientProperty @relation(fields: [propertyId], references: [id])
  contractor       Contractor?   @relation("ContractorJobs", fields: [contractorId], references: [id])
  tenant           Tenant?       @relation(fields: [tenantId], references: [id])
  documents        JobDocument[]
  photos           JobPhoto[]

  @@index([jobNumber])
  @@index([status])
  @@index([type])
  @@index([contractorId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([scheduledDate])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
}

model JobDocument {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_documents")
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  caption   String?
  takenAt   DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_photos")
}

// ============================================
// Notification Log
// ============================================

model NotificationLog {
  id          String   @id @default(cuid())
  type        String   // email | sms
  channel     String   // job_created | contractor_assigned | work_started | job_completed | invoice_generated
  recipientId String?
  recipient   String   // email address or phone number
  jobId       String?
  jobNumber   String?
  subject     String?
  status      String   @default("sent") // sent | failed | bounced
  errorMessage String?
  sentAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([recipientId])
  @@index([channel])
  @@index([sentAt])
  @@map("notification_logs")
}
