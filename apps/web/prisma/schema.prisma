  @@index([jobType])
  @@index([createdAt])
  @@index([tenantId])
  @@map("ai_batch_processing_jobs")
}

// ============================================
// Background Job Queue Models
// ============================================

model BackgroundJob {
  id              String   @id @default(cuid())

  // Job Classification
  jobType         String   // "CONTRACTOR_MATCHING", "CONTRACTOR_NOTIFICATION", etc.
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRY
  priority        Int      @default(5) // 1=critical, 5=normal, 10=low

  // Payload
  input           Json
  output          Json?

  // Error Tracking
  attemptCount    Int      @default(0)
  maxAttempts     Int      @default(3)
  lastError       String?  @db.Text
  errorStack      String?  @db.Text

  // Scheduling
  scheduledFor    DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  nextRetryAt     DateTime?

  // Relations
  claimId         String?
  tenantId        String?
  initiatedBy     String?

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  claim           PublicClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  initiator       User?        @relation("BackgroundJobInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([jobType, status])
  @@index([claimId])
  @@index([priority, scheduledFor])
  @@index([tenantId])
  @@index([createdAt])
  @@map("background_jobs")
}

