  status          String

  // Progress Tracking
  totalImages     Int
  processedImages Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  totalCostUSD    Decimal  @db.Decimal(10, 2) @default(0)

  // Timestamps
  startedAt       DateTime?
