# Linguist language detection configuration
# Mark TypeScript/JavaScript as primary languages

# TypeScript files
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# JavaScript files
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.mjs linguist-language=JavaScript

# Mark generated files
*.min.js linguist-generated=true
*.min.css linguist-generated=true
package-lock.json linguist-generated=true
.next/* linguist-generated=true
node_modules/* linguist-vendored=true

# Documentation
*.md linguist-documentation=true

# Ensure CSS is properly detected
*.css linguist-language=CSS
*.scss linguist-language=SCSS

# Mark vendor files
public/vendor/* linguist-vendored=true

# Ensure JSON files are properly categorized
*.json linguist-language=JSON