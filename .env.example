# AI Image Enhancement Configuration
AI_IMAGE_ENHANCEMENT_ENABLED=true
AI_IMAGE_ENHANCEMENT_MAX_BATCH_SIZE=100
AI_IMAGE_ENHANCEMENT_MAX_COST_USD=100.00
AI_IMAGE_ENHANCEMENT_RATE_LIMIT_RPM=400
AI_IMAGE_ENHANCEMENT_MODEL=gpt-5.2  # Latest model (2026) - also supports: gpt-5.2-pro, gpt-4.1, gpt-4o

# OpenAI API
OPENAI_API_KEY=sk-...

# Database
DATABASE_URL=postgresql://...

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
