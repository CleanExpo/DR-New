# ========================================
# Disaster Recovery Platform
# Environment Configuration Template
# ========================================

# IMPORTANT: Copy this file to .env.local for development
# cp .env.example .env.local

# ========================================
# CORE APPLICATION
# ========================================

# Node Environment (development, production, test)
NODE_ENV=development

# Application URLs
# Production: https://dr-new-ten.vercel.app
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Required: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-minimum-32-chars

# ========================================
# DATABASE
# ========================================

# SQLite (Development - default)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production - recommended)
# DATABASE_URL="postgresql://user:password@localhost:5432/disaster_recovery"

# ========================================
# AUTHENTICATION & SESSION
# ========================================

SESSION_COOKIE_NAME=dr-session
SESSION_COOKIE_MAX_AGE=86400
JWT_SECRET=
JWT_REFRESH_SECRET=

# 2FA Configuration
ENABLE_2FA=false

# ========================================
# EMAIL SERVICE
# ========================================

EMAIL_FROM=noreply@disasterrecovery.com.au

# SendGrid (Option 1)
SENDGRID_API_KEY=

# Resend (Option 2)
RESEND_API_KEY=

# ========================================
# SMS SERVICE (TWILIO)
# ========================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# ========================================
# AI SERVICES
# ========================================

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ========================================
# MAPS & GEOLOCATION
# ========================================

GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ========================================
# PAYMENT PROCESSING (STRIPE)
# ========================================

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================================
# STORAGE
# ========================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=disaster-recovery-assets

# Cloudinary (Alternative)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========================================
# ANALYTICS
# ========================================

GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ========================================
# ERROR TRACKING & MONITORING
# ========================================

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=disaster-recovery

# ========================================
# REDIS (CACHING & QUEUE)
# ========================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upstash Redis (Cloud alternative)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ========================================
# WEBSOCKET
# ========================================

NEXT_PUBLIC_WS_URL=http://localhost:3001
WEBSOCKET_PORT=3002
ENABLE_WEBSOCKET=true

# ========================================
# FEATURE FLAGS
# ========================================

ENABLE_AUDIO=false
ENABLE_NOTIFICATIONS=true
ENABLE_CHAT=true
ENABLE_API_RATE_LIMITING=true
ENABLE_BACKGROUND_CHECKS=false

# ========================================
# RATE LIMITING
# ========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# CORS CONFIGURATION
# ========================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dr-new-ten.vercel.app

# ========================================
# PERFORMANCE & CACHING
# ========================================

CACHE_MAX_SIZE=100000000
CACHE_TTL=3600

# ========================================
# MAINTENANCE MODE
# ========================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please check back soon."

# ========================================
# LOGGING
# ========================================

LOG_LEVEL=info

# ========================================
# BUILD & DEPLOYMENT
# ========================================

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Vercel (set automatically in production)
# VERCEL=1
# VERCEL_URL=
# VERCEL_ENV=

# ========================================
# DEVELOPMENT TOOLS
# ========================================

# Enable detailed error messages in development
NEXT_PUBLIC_ENABLE_DEBUG=false

# Skip Husky hooks (CI environments)
# CI=true

# ========================================
# NOTES
# ========================================

# 1. Never commit .env.local or .env files to git
# 2. Always use NEXT_PUBLIC_ prefix for client-side variables
# 3. Generate secure secrets: openssl rand -base64 32
# 4. Set production variables in Vercel dashboard
# 5. Keep this file updated when adding new variables
