# ============================================================================
# DR-NRPG Platform - Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in ALL values
# NEVER commit .env.local to version control
# Last Updated: 2026-02-04
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Required)
# ============================================================================

# Primary database URL (pooled connection for application queries)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct database URL (non-pooled for migrations)
DIRECT_URL="postgresql://user:password@direct-host:5432/database?sslmode=require"

# ============================================================================
# REDIS CONFIGURATION (Required)
# ============================================================================

REDIS_URL="redis://localhost:6379"

# ============================================================================
# AUTHENTICATION (Required)
# ============================================================================

# Generate with: openssl rand -base64 32
# ROTATE IMMEDIATELY if this value was ever committed to git or visible in logs.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<run: openssl rand -base64 32>"

# Separate JWT signing secret (falls back to NEXTAUTH_SECRET if not set)
# Generate with: openssl rand -base64 32
JWT_SECRET="<run: openssl rand -base64 32>"

# ============================================================================
# PAYMENT PROCESSING (Required)
# ============================================================================

STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_RESTRICTED_KEY="rk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Bearer token for /api/webhooks/monitoring endpoint
# Generate with: openssl rand -hex 32
WEBHOOK_MONITOR_SECRET="generate-with-openssl-rand-hex-32"

# ============================================================================
# EMAIL SERVICE (Required)
# ============================================================================

EMAIL_PROVIDER="sendgrid"
SENDGRID_API_KEY="SG.your_api_key_here"
EMAIL_FROM="support@disasterrecovery.com.au"
EMAIL_FROM_NAME="NRPG Team"

# ============================================================================
# AI/ML CONFIGURATION (Optional)
# ============================================================================

OPENAI_API_KEY="sk-proj-your_key_here"
GOOGLE_GENERATIVE_AI_API_KEY="your_key_here"
GEMINI_API_KEY="your_key_here"

# ============================================================================
# REALTIME FEATURES (Required)
# ============================================================================

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# ============================================================================
# ERROR TRACKING (Recommended)
# ============================================================================

NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn_here"

# ============================================================================
# XERO ACCOUNTING INTEGRATION (Optional)
# ============================================================================

XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
XERO_TENANT_ID=""
XERO_WEBHOOK_KEY=""

# ============================================================================
# ANALYTICS (Required for system-to-system event recording)
# ============================================================================

# Generate with: openssl rand -hex 32
ANALYTICS_API_KEY="generate-with-openssl-rand-hex-32"

# ============================================================================
# CORS CONFIGURATION (Production)
# ============================================================================

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="https://disasterrecovery.com.au,https://nrpg.com.au"

# ============================================================================
# CRON JOBS
# ============================================================================

# Secret token for securing scheduled cron endpoints (Vercel Cron)
# Generate with: openssl rand -hex 32
CRON_SECRET="generate-with-openssl-rand-hex-32"

# ============================================================================
# UPTIME MONITORING (Recommended)
# ============================================================================

# BetterStack log drain source token (see docs/guides/UPTIME-MONITORING.md)
BETTERSTACK_SOURCE_TOKEN=""

# ============================================================================
# PRINTFUL DROPSHIPPING (Required for NRPG Store)
# ============================================================================

PRINTFUL_API_KEY="your_printful_api_key"
PRINTFUL_STORE_ID="your_printful_store_id"
PRINTFUL_WEBHOOK_SECRET="your_printful_webhook_secret"

# ============================================================================
# BUSINESS CONFIGURATION
# ============================================================================

NRPG_RECRUITMENT_PHONE="1800 XXXX XXXX"

# See FINAL_HANDOVER.md for complete variable documentation
