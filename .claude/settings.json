{
  "projectName": "Disaster Recovery NRPG",
  "version": "1.0.0",
  "lastUpdated": "2026-01-03",
  "systemsComplete": 17,
  "systemsTotal": 17,
  "techStack": {
    "framework": "Next.js 14",
    "database": "PostgreSQL",
    "search": "PostgreSQL Full-Text",
    "cms": "Sanity",
    "payments": "Stripe",
    "auth": "NextAuth"
  },
  "businessRules": {
    "phoneNumbers": false,
    "contactEmail": "support@disasterrecovery.com.au",
    "australianEnglish": true,
    "dynamicSeoGeneration": true
  },
  "tierPricing": {
    "rural": { "maxPopulation": 50000, "price": 395 },
    "semiRural": { "maxPopulation": 200000, "price": 595 },
    "tier1": { "maxPopulation": 400000, "price": 795 },
    "tier2": { "maxPopulation": 1000000, "price": 995 },
    "tier3": { "maxPopulation": null, "price": 1095 }
  },
  "bufferPercentage": 10,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .superpowers/hooks/session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "if": "Bash(git commit *)",
            "prompt": "BEFORE committing: Run `pnpm --package=typescript dlx tsc --noEmit --skipLibCheck` from the apps/web directory and verify zero TypeScript errors. Warnings about @types/jest or @testing-library are acceptable and not blocking. Do NOT use `npx tsc` — it is intentionally replaced in this project with a stub that always exits 1. If tsc reports real errors, fix them before allowing the commit. Respond with the tsc result."
          }
        ]
      }
    ]
  }
}
