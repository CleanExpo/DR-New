# Disaster Recovery Voice Handler - Environment Configuration
# Project: Disaster Recovery & NRPG (NOT RestoreAssist)
# Business: Phill McGurk - IICRC Master Restorer

# ==============================================================================
# ELEVENLABS VOICE API CONFIGURATION
# ==============================================================================

# ElevenLabs API Key
# Sign up at: https://elevenlabs.io
# Get your API key from: https://elevenlabs.io/app/speech-synthesis
ELEVENLABS_API_KEY=your_api_key_here

# Voice ID Selection
# Choose from ElevenLabs voice library for professional Australian male voice
# Recommended: Professional, mature, authoritative tone (45-year-old trades professional)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Voice Model
# Options: eleven_multilingual_v2, eleven_turbo_v2, eleven_monolingual_v1
# Recommended: eleven_multilingual_v2 (best quality)
ELEVENLABS_MODEL=eleven_multilingual_v2

# ==============================================================================
# VOICE SETTINGS
# ==============================================================================

# Stability (0.0 to 1.0)
# Higher = more stable/consistent voice
# Recommended: 0.75 for professional emergency response
VOICE_STABILITY=0.75

# Similarity Boost (0.0 to 1.0)
# Higher = closer to original voice characteristics
# Recommended: 0.85 for authentic Australian accent
VOICE_SIMILARITY_BOOST=0.85

# Style (0.0 to 1.0)
# Voice style exaggeration
# Recommended: 0.5 for natural conversational tone
VOICE_STYLE=0.5

# Speaker Boost (true/false)
# Enhance speaker clarity
# Recommended: true for emergency messaging
VOICE_SPEAKER_BOOST=true

# ==============================================================================
# AUDIO CONFIGURATION
# ==============================================================================

# Streaming Latency (0-4)
# Higher = lower latency, lower quality
# Recommended: 3 for real-time emergency response
STREAMING_LATENCY=3

# Output Format
# Options: mp3_44100_128, mp3_44100_192, pcm_16000, pcm_22050, pcm_24000
# Recommended: mp3_44100_128 for web playback
AUDIO_OUTPUT_FORMAT=mp3_44100_128

# ==============================================================================
# BUSINESS CONFIGURATION
# ==============================================================================

# Emergency Contact
EMERGENCY_CONTACT=1300 309 361

# Business Name
BUSINESS_NAME=Disaster Recovery Brisbane/Ipswich/Logan

# Master Restorer
MASTER_RESTORER=Phill McGurk - IICRC Master Restorer

# Service Areas (comma-separated)
SERVICE_AREAS=Brisbane,Ipswich,Logan

# Credentials (ONLY ONE)
CREDENTIALS=IICRC Master Restorer

# Pricing
ASSESSMENT_FEE_FROM=550
RESTORATION_SERVICES_FROM=2750

# ==============================================================================
# USAGE INSTRUCTIONS
# ==============================================================================
#
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual configuration
# 3. Never commit .env file to git (already in .gitignore)
# 4. Load environment variables before running bot
#
# Windows:
#   set ELEVENLABS_API_KEY=your_key
#
# Linux/Mac:
#   export ELEVENLABS_API_KEY=your_key
#
# Python:
#   from dotenv import load_dotenv
#   load_dotenv()
#
# ==============================================================================
